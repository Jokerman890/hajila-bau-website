    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.0",
    "image-size": "^2.0.2",
    "lucide-react": "^0.523.0",
    "motion": "^12.22.0",
    "next": "15.5.9",
