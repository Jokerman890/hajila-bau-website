{
  "name": "hajila-website",
  "version": "0.4.6",
  "private": true,
  "type": "module",
  "scripts": {
    "prebuild": "node scripts/update-version.js",
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "export": "next export",
    "test": "node scripts/run-tests.js",
    "test:watch": "jest --config jest.config.mjs --watch",
    "test:coverage": "jest --config jest.config.mjs --coverage",
    "test:debug": "node --inspect-brk node_modules/.bin/jest --config jest.config.mjs --runInBand",
    "test:unit": "jest --config jest.config.mjs src --coverage",
    "test:integration": "jest --config jest.config.mjs scripts/__tests__ --coverage",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d out",
    "assets:scan": "node scripts/assets-scan.js",
    "assets:scan:hires": "node scripts/assets-scan.js --thresholdKB=500",
    "assets:cleanup": "node scripts/monthly-asset-cleanup.js",
    "assets:cleanup:dry-run": "node scripts/monthly-asset-cleanup.js --dry-run",
    "report:status": "node scripts/status-report.js",
  "generate:dashboard": "node scripts/generate-dashboard.cjs",
    "docs:diff:init": "node scripts/context7-docs-diff.js --init",
    "docs:diff": "node scripts/context7-docs-diff.js"
  },
  "dependencies": {
    "@21st-extension/react": "^0.5.6",
    "@21st-extension/toolbar-next": "^0.5.6",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.5",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.12",
    "@supabase/supabase-js": "^2.50.3",
    "@types/image-size": "^0.7.0",
    "@types/uuid": "^10.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.0.1",
    "firebase": "^11.10.0",
    "firebase-admin": "^13.4.0",
    "framer-motion": "^12.23.0",
    "image-size": "^2.0.2",
    "lucide-react": "^0.523.0",
    "motion": "^12.22.0",
    "next": "^15.3.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.3.1",
    "three": "^0.177.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.3",
    "@babel/plugin-transform-modules-commonjs": "^7.27.1",
    "@babel/plugin-transform-runtime": "^7.28.3",
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@babel/runtime": "^7.28.3",
    "@eslint/eslintrc": "^3",
    "@jest/globals": "^29.7.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.6.3",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.28",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@types/testing-library__jest-dom": "^5.14.9",
    "@types/three": "^0.177.0",
    "babel-jest": "^29.7.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "14.1.3",
    "gh-pages": "^6.1.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-junit": "^16.0.0",
    "tailwindcss": "^4",
    "ts-jest": "^29.4.0",
    "tw-animate-css": "^1.3.4",
    "typescript": "^5.3.3"
  }
}
